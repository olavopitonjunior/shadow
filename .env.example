# ============================================
# Shadow MVP - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# === Owner Configuration ===
# Your WhatsApp phone number in E.164 format (required)
SHADOW_OWNER_E164=+5511999999999

# === Agent API ===
# Host and port for the Python agent
SHADOW_AGENT_HOST=0.0.0.0
SHADOW_AGENT_PORT=8090

# API token for authentication (recommended in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHADOW_AGENT_TOKEN=

# === Gateway Configuration ===
# URL to send messages back to WhatsApp (via gateway)
SHADOW_GATEWAY_SEND_URL=http://localhost:3001/send

# === Access Control ===
# Access mode: "owner_only", "allowlist", or "open"
SHADOW_ACCESS_MODE=owner_only

# Comma-separated list of allowed phone numbers (for allowlist mode)
SHADOW_ALLOWLIST=

# === Rate Limiting ===
# Maximum requests per window
SHADOW_RATE_LIMIT_MAX=30

# Window size in seconds
SHADOW_RATE_LIMIT_WINDOW=60

# === Storage Configuration ===
# Use Supabase for storage (true/false)
SHADOW_USE_SUPABASE=false

# Path to SQLite database (for local storage)
SHADOW_DB_PATH=./data/shadow.db

# === Supabase Configuration ===
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI/LLM Configuration (Optional) ===
# Google Gemini API key (for transcription, OCR, entity extraction)
GEMINI_API_KEY=

# Alternative: Google API key
GOOGLE_API_KEY=

# OpenAI API key (for Whisper transcription fallback)
OPENAI_API_KEY=

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SHADOW_LOG_LEVEL=INFO

# Log format: "text" or "json"
SHADOW_LOG_FORMAT=text

# === WhatsApp Gateway Options ===
# Trigger tokens for group messages (comma-separated)
SHADOW_TRIGGER_TOKENS=@shadow,/shadow

# Comma-separated phones that can interact (besides owner)
SHADOW_ALLOWED_CALLERS=

# === Evolution API (Production Gateway) ===
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# === Z-API (Alternative Gateway) ===
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# === Scheduler ===
# Daily summary hour (0-23, in owner's timezone)
SHADOW_DAILY_SUMMARY_HOUR=9

# Timezone for scheduling
SHADOW_TIMEZONE=America/Sao_Paulo
