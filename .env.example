# ============================================
# Shadow MVP - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# === Owner Configuration ===
# Your WhatsApp phone number in E.164 format (required)
SHADOW_OWNER_E164=+5511999999999

# === Agent API ===
# Host and port for the Python agent
SHADOW_AGENT_HOST=0.0.0.0
SHADOW_AGENT_PORT=8090

# Base64-encoded 32-byte key for message encryption at rest
# Example: openssl rand -base64 32
SHADOW_MASTER_KEY=

# API token for authentication (recommended in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHADOW_AGENT_TOKEN=

# === Gateway Configuration ===
# URL to send messages back to WhatsApp (via Baileys gateway)
SHADOW_GATEWAY_SEND_URL=http://localhost:18790/send

# === Access Control ===
# Access mode: "owner_only", "allowlist", or "open"
SHADOW_ACCESS_MODE=owner_only

# Comma-separated list of allowed phone numbers (for allowlist mode)
SHADOW_ALLOWLIST=

# === Conversation Monitoring (Proactive Suggestions) ===
# Monitor ALL conversations (groups + direct messages) for entity extraction
# When true, ignores SHADOW_MONITORED_GROUPS and SHADOW_MONITORED_CONTACTS
SHADOW_MONITOR_ALL_GROUPS=false

# Comma-separated list of group JIDs to monitor (e.g., "120363425697918997@g.us")
# Messages from these groups will be sent to agent for entity extraction
# but Shadow will NOT reply (monitor-only mode)
SHADOW_MONITORED_GROUPS=

# Comma-separated list of phone numbers to monitor (E.164 format: +5511999999999)
# Direct messages from these contacts will be captured for entity extraction
SHADOW_MONITORED_CONTACTS=

# === Rate Limiting ===
# Maximum requests per window
SHADOW_RATE_LIMIT_MAX=30

# Window size in seconds
SHADOW_RATE_LIMIT_WINDOW=60

# === Storage Configuration ===
# Use Supabase for storage (true/false)
SHADOW_USE_SUPABASE=false

# Path to SQLite database (for local storage)
SHADOW_DB_PATH=./data/shadow.db

# === Supabase Configuration ===
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === AI/LLM Configuration (Optional) ===
# Google Gemini API key (for transcription, OCR, entity extraction)
GEMINI_API_KEY=

# Alternative: Google API key
GOOGLE_API_KEY=

# OpenAI API key (for Whisper transcription fallback)
OPENAI_API_KEY=

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SHADOW_LOG_LEVEL=INFO

# Log format: "text" or "json"
SHADOW_LOG_FORMAT=text

# === WhatsApp Gateway Options ===
# Trigger tokens for group messages (comma-separated)
SHADOW_TRIGGER_TOKENS=@shadow,/shadow

# === WhatsApp Gateway ===
# The local Baileys gateway is the primary integration.
# Evolution API and Z-API have been removed in favor of direct Baileys connection.
# See shadow/gateway/ for the Baileys implementation.

# === Channel API (Evolution API) ===
# Enable the official channel (Shadow's own WhatsApp number)
SHADOW_CHANNEL_ENABLED=false

# Adapter type: "evolution" (self-hosted, free) or "meta_cloud" (official API)
SHADOW_CHANNEL_ADAPTER=evolution

# Evolution API settings (self-hosted via Docker)
# The API key is chosen by YOU when deploying - pick any strong string
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=shadow-evo-key
EVOLUTION_INSTANCE=shadow

# Meta Cloud API settings (official, requires Meta Business verification)
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_WABA_ID=
# META_VERIFY_TOKEN=
# META_APP_SECRET=

# === LangGraph Multi-Agent Orchestration ===
# Enable LangGraph supervisor (false = use legacy ReActAgent)
SHADOW_USE_LANGGRAPH=false

# === Z-API (WhatsApp data collection) ===
# Get credentials from https://z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# === LLM Providers ===
# Primary: Anthropic Claude (supervisor + workers)
ANTHROPIC_API_KEY=

# Fallback: Google Gemini (used when Anthropic rate-limited)
# Also used for audio transcription + OCR
GEMINI_API_KEY=

# Embeddings: OpenAI text-embedding-3-small
OPENAI_API_KEY=

# === LangSmith Observability (optional) ===
# Enable tracing to LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=shadow-prod
LANGCHAIN_API_KEY=

# Fraction of requests to trace (0.0 to 1.0, default 10%)
LANGSMITH_SAMPLE_RATE=0.1

# === Scheduler ===
# Daily summary hour (0-23, in owner's timezone)
SHADOW_DAILY_SUMMARY_HOUR=9

# Timezone for scheduling
SHADOW_TIMEZONE=America/Sao_Paulo
