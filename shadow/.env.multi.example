# Shadow Multi-Tenant Configuration
# Copy to .env.multi and fill in the values

# ============ GLOBAL CONFIG ============
SHADOW_ACCESS_MODE=open
SHADOW_LOG_LEVEL=info

# Supabase (shared)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
SHADOW_USE_SUPABASE=true

# Encryption (base64 32 bytes)
SHADOW_MASTER_KEY=

# Gemini API (shared)
GEMINI_API_KEY=YOUR_GEMINI_KEY

# ============ USER 1 ============
SHADOW_USER1_PHONE=+5511999999991
SHADOW_USER1_TOKEN=user1-secret-token

# ============ USER 2 ============
SHADOW_USER2_PHONE=+5511999999992
SHADOW_USER2_TOKEN=user2-secret-token

# ============ USER 3 ============
SHADOW_USER3_PHONE=+5511999999993
SHADOW_USER3_TOKEN=user3-secret-token

# ============ USER 4 ============
SHADOW_USER4_PHONE=+5511999999994
SHADOW_USER4_TOKEN=user4-secret-token
