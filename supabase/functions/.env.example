# Edge Functions Environment Variables (Shadow MVP)

# Supabase (auto-set in cloud, required for local dev)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Frontend URL (for CORS if you add a UI)
FRONTEND_URL=http://localhost:5173

# Gemini (for contact analysis / media transcription)
GEMINI_API_KEY=your_gemini_api_key

# Shadow owner (optional fallback)
SHADOW_OWNER_PHONE=5511999999999

# Encryption (base64 32 bytes)
SHADOW_MASTER_KEY=

# Debug logs (store payloads in shadow_webhook_logs)
SHADOW_LOG_PAYLOADS=0

# WhatsApp Gateway
# Evolution API and Z-API have been removed in favor of local Baileys gateway.
# See shadow/gateway/ for the Baileys implementation.
# Edge Functions are DEPRECATED - use shadow/agent/scheduler.py instead.
